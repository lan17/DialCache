{
  "name": "dialcache-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "benchmark:request-local": "pnpm --dir typescript benchmark:request-local",
    "benchmark:redis-write": "pnpm --dir typescript benchmark:redis-write",
    "benchmark:stale-on-error": "pnpm --dir typescript benchmark:stale-on-error",
    "build": "pnpm --dir typescript build",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm test:package",
    "docs:dev": "pnpm docs:generate && vitepress dev docs",
    "docs:build": "pnpm docs:check && pnpm docs:generate && vitepress build docs && node scripts/check-docs.mjs --links",
    "docs:preview": "vitepress preview docs",
    "typecheck": "pnpm --dir typescript typecheck && tsc --project docs/tsconfig.json --noEmit",
    "test": "pnpm --dir typescript test",
    "test:integration": "pnpm --dir typescript test:integration",
    "test:package": "pnpm --dir typescript test:package",
    "test:watch": "pnpm --dir typescript test:watch",
    "docs:generate": "node scripts/generate-docs.mjs",
    "docs:check": "node --test scripts/check-docs.test.mjs && node scripts/check-docs.mjs"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "brace-expansion@<5.0.9": "5.0.9",
      "esbuild@<0.28.1": "^0.28.1",
      "vitepress@1.6.4>vite": "^6.4.3"
    }
  },
  "engines": {
    "node": ">=22.15.0 <23.0.0 || >=23.8.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.14",
    "typedoc": "0.28.20",
    "typescript": "^5.9.3",
    "vitepress": "1.6.4",
    "vitest": "^4.0.14",
    "@types/node": "^24.10.1"
  }
}
