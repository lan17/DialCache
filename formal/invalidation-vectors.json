      "expected": {
        "error": true,
        "watermark": "123",
        "ttlMs": 20000000
      }
    },
    {
      "name": "over-limit buffer rejects before mutation",
      "existing": {
        "kind": "string",
        "value": "123",
        "ttlMs": 20000000
      },
      "futureBufferMs": "31536000001",
      "invalidatedAtMs": "1000",
      "expected": {
        "error": true,
        "watermark": "123",
        "ttlMs": 20000000
      }
    },
    {
      "name": "exponent timestamp rejects before mutation",
      "existing": {
        "kind": "string",
        "value": "123",
        "ttlMs": 20000000
      },
      "futureBufferMs": "0",
