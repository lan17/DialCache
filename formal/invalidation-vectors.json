{
  "schemaVersion": 1,
  "vectors": [
    {
      "name": "absent marker gets the two hour floor",
      "existing": {
        "kind": "absent"
      },
      "futureBufferMs": "0",
      "invalidatedAtMs": "1000",
      "expected": {
        "watermark": "1000",
        "ttlMs": 7200000
      }
    },
    {
      "name": "buffer determines marker cutoff",
      "existing": {
        "kind": "absent"
      },
      "futureBufferMs": "200",
      "invalidatedAtMs": "1000",
      "expected": {
        "watermark": "1200",
        "ttlMs": 7200000
      }
    },
    {
      "name": "large buffer extends retention beyond the floor",
      "existing": {
        "kind": "absent"
      },
      "futureBufferMs": "4000000",
      "invalidatedAtMs": "1000",
      "expected": {
        "watermark": "4001000",
        "ttlMs": 7660000
      }
    },
    {
      "name": "existing future cutoff never moves backwards",
      "existing": {
        "kind": "string",
        "value": "10000000",
        "ttlMs": 100
      },
      "futureBufferMs": "0",
      "invalidatedAtMs": "1000",
      "expected": {
        "watermark": "10000000",
        "ttlMs": 13659000
      }
    },
    {
      "name": "existing longer TTL never shrinks",
      "existing": {
        "kind": "string",
        "value": "900",
        "ttlMs": 20000000
      },
      "futureBufferMs": "0",
      "invalidatedAtMs": "1000",
      "expected": {
        "watermark": "1000",
        "ttlMs": 20000000
      }
    },
    {
      "name": "persistent valid marker stays persistent",
      "existing": {
        "kind": "string",
        "value": "2000",
        "ttlMs": -1
      },
      "futureBufferMs": "0",
      "invalidatedAtMs": "1000",
      "expected": {
        "watermark": "2000",
        "ttlMs": -1
      }
    },
    {
      "name": "malformed finite marker is repaired with longer TTL preserved",
      "existing": {
        "kind": "string",
        "value": "bad",
        "ttlMs": 20000000
      },
      "futureBufferMs": "0",
      "invalidatedAtMs": "1000",
      "expected": {
        "watermark": "1000",
        "ttlMs": 20000000
      }
    },
    {
      "name": "malformed persistent marker stays persistent",
      "existing": {
        "kind": "string",
        "value": "bad",
        "ttlMs": -1
      },
      "futureBufferMs": "0",
      "invalidatedAtMs": "1000",
      "expected": {
        "watermark": "1000",
        "ttlMs": -1
      }
    },
    {
      "name": "wrong type persistent marker gets finite repair",
      "existing": {
        "kind": "list",
        "ttlMs": -1
      },
      "futureBufferMs": "0",
      "invalidatedAtMs": "1000",
      "expected": {
        "watermark": "1000",
        "ttlMs": 7200000
      }
    },
    {
      "name": "wrong type marker does not preserve unrelated TTL",
      "existing": {
        "kind": "list",
        "ttlMs": 20000000
      },
      "futureBufferMs": "0",
      "invalidatedAtMs": "1000",
      "expected": {
        "watermark": "1000",
        "ttlMs": 7200000
      }
    },
    {
      "name": "leading decimal zeros are canonicalized",
      "existing": {
        "kind": "string",
        "value": "00002000",
        "ttlMs": 100
      },
      "futureBufferMs": "0000",
      "invalidatedAtMs": "0001000",
      "expected": {
        "watermark": "2000",
        "ttlMs": 7200000
      }
    },
    {
      "name": "maximum future buffer is supported",
      "existing": {
        "kind": "absent"
      },
      "futureBufferMs": "31536000000",
      "invalidatedAtMs": "1000",
      "expected": {
        "watermark": "31536001000",
        "ttlMs": 31539660000
      }
    },
    {
      "name": "maximum safe sum is supported",
      "existing": {
        "kind": "absent"
      },
      "futureBufferMs": "1",
      "invalidatedAtMs": "9007199254740990",
      "expected": {
        "watermark": "9007199254740991",
        "ttlMs": 7200000
      }
    },
    {
      "name": "negative buffer rejects before mutation",
      "existing": {
        "kind": "string",
        "value": "123",
        "ttlMs": 20000000
      },
      "futureBufferMs": "-1",
      "invalidatedAtMs": "1000",
      "expected": {
        "error": true,
        "watermark": "123",
        "ttlMs": 20000000
      }
    },
    {
      "name": "fractional buffer rejects before mutation",
      "existing": {
        "kind": "string",
        "value": "123",
        "ttlMs": 20000000
      },
      "futureBufferMs": "1.5",
