      "expected": {
        "error": true,
        "watermark": "123",
        "ttlMs": 20000000
      }
    },
    {
      "name": "negative timestamp rejects before mutation",
      "existing": {
        "kind": "string",
        "value": "123",
        "ttlMs": 20000000
      },
      "futureBufferMs": "0",
      "invalidatedAtMs": "-1",
      "expected": {
        "error": true,
        "watermark": "123",
        "ttlMs": 20000000
      }
    },
    {
      "name": "unsafe sum rejects before mutation",
      "existing": {
        "kind": "string",
        "value": "123",
        "ttlMs": 20000000
      },
      "futureBufferMs": "1",
